generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model detalles_pedido {
  id                  Int                 @id @default(autoincrement())
  pedido_id           Int
  producto_id         Int
  cantidad            Int
  nombre_snapshot     String?             @db.VarChar(150)
  precio_unitario_usd Decimal             @db.Decimal(10, 2)
  precio_unitario_ars Decimal?            @db.Decimal(15, 2)
  subtotal_usd        Decimal             @db.Decimal(10, 2)
  subtotal_ars        Decimal?            @db.Decimal(15, 2)
  ojo                 detalles_pedido_ojo
  esfera              Decimal?            @db.Decimal(5, 2)
  cilindro            Decimal?            @db.Decimal(5, 2)
  eje                 Int?
  adicion             Decimal?            @db.Decimal(4, 2)
  prisma              Decimal?            @db.Decimal(5, 2)
  eje_prisma          Int?
  armazon_transversal Decimal?            @db.Decimal(5, 2)
  armazon_altura      Decimal?            @db.Decimal(5, 2)
  armazon_diagonal    Decimal?            @db.Decimal(5, 2)
  armazon_puente      Decimal?            @db.Decimal(5, 2)
  pedidos             pedidos             @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "detalles_pedido_ibfk_1")
  productos           productos           @relation(fields: [producto_id], references: [id], onUpdate: Restrict, map: "detalles_pedido_ibfk_2")
  detalles_pedido_tratamientos detalles_pedido_tratamientos[]

  @@index([pedido_id], map: "pedido_id")
  @@index([producto_id], map: "producto_id")
}

model pedidos {
  id                    Int               @id @default(autoincrement())
  usuario_id            Int
  idempotency_key       String?           @unique @db.VarChar(100)
  fecha_pedido          DateTime?         @default(now()) @db.DateTime(0)
  estado                pedidos_estado?   @default(PENDIENTE)
  cotizacion_dolar_dia  Decimal           @db.Decimal(10, 2)
  total_usd             Decimal           @db.Decimal(12, 2)
  total_ars             Decimal           @db.Decimal(15, 2)
  // Envío
  direccion_envio       String?           @db.VarChar(255)
  codigo_postal         String?           @db.VarChar(10)
  localidad             String?           @db.VarChar(100)
  provincia_envio       String?           @db.VarChar(50)
  metodo_envio          String?           @db.VarChar(50) // "ANDREANI" | "CORREO_ARGENTINO" | "OCA"
  // Notas
  notas_cliente         String?           @db.Text
  notas_admin           String?           @db.Text
  // Facturación
  tipo_comprobante      tipo_comprobante?  @default(REMITO)
  monto_iva_ars         Decimal?          @default(0) @db.Decimal(15, 2)
  // Pagos
  total_pagado_ars      Decimal?          @default(0) @db.Decimal(15, 2)
  descuento_anticipado  Decimal?          @default(0) @db.Decimal(15, 2)
  // Relaciones
  detalles_pedido       detalles_pedido[]
  reclamos              reclamos[]
  pagos                 pagos[]
  usuarios              usuarios          @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "pedidos_ibfk_1")

  @@index([fecha_pedido], map: "idx_pedidos_fecha")
  @@index([usuario_id], map: "idx_pedidos_usuario")
}

model productos {
  id                Int               @id @default(autoincrement())
  codigo_sku        String?           @unique(map: "codigo_sku") @db.VarChar(50)
  nombre            String            @db.VarChar(150)
  descripcion       String?           @db.Text
  material          String?           @db.VarChar(50)
  linea             String?           @db.VarChar(50)
  indice_refraccion Decimal?          @db.Decimal(4, 3)
  rango_dioptrias   String?           @db.VarChar(100)
  esfera_desde      Decimal?          @db.Decimal(5, 2)
  esfera_hasta      Decimal?          @db.Decimal(5, 2)
  cilindro_hasta    Decimal?          @db.Decimal(5, 2)
  precio_base_usd   Decimal           @db.Decimal(10, 4)
  stock_actual      Int?              @default(0)
  suma_max_pos      Decimal?          @db.Decimal(5, 2)
  suma_max_neg      Decimal?          @db.Decimal(5, 2)
  detalles_pedido   detalles_pedido[]

  @@index([material], map: "idx_productos_material")
}

model usuarios {
  id               Int           @id @default(autoincrement())
  nombre           String        @db.VarChar(100)
  apellido         String        @db.VarChar(100)
  cuil             String?       @db.VarChar(11)
  email            String        @unique(map: "email") @db.VarChar(150)
  password_hash    String        @db.VarChar(255)
  telefono         String?       @db.VarChar(20)
  calle            String?       @db.VarChar(100)
  numeracion       String?       @db.VarChar(20)
  departamento     String?       @db.VarChar(20)
  provincia        String?       @db.VarChar(50)
  codigo_postal    String?       @db.VarChar(10)
  localidad        String?       @db.VarChar(100)
  razon_social     String?       @db.VarChar(200)
  condicion_fiscal String?       @db.VarChar(50)
  rol              usuarios_rol? @default(CLIENTE)
  fecha_registro   DateTime?     @default(now()) @db.DateTime(0)
  activo           Boolean?      @default(true)
  pedidos          pedidos[]
  reclamos         reclamos[]
  pagos_registrados pagos[]
}

enum pedidos_estado {
  PENDIENTE
  CONFIRMADO
  EN_PROCESO
  ENVIADO
  FINALIZADO
  CANCELADO
}

enum detalles_pedido_ojo {
  DERECHO
  IZQUIERDO
  AMBOS
}

enum usuarios_rol {
  CLIENTE
  ADMIN
}

enum tipo_comprobante {
  FACTURA_A
  REMITO
}

model tratamientos {
  id         Int      @id @default(autoincrement())
  codigo     String   @unique(map: "codigo_tratamiento") @db.VarChar(50)
  nombre     String   @db.VarChar(150)
  categoria  String?  @db.VarChar(50)
  precio_usd Decimal  @db.Decimal(10, 4)
  porcentaje Int?     @default(0)
  estado     Boolean? @default(true)
  detalles_pedido_tratamientos detalles_pedido_tratamientos[]
}

model detalles_pedido_tratamientos {
  id                Int             @id @default(autoincrement())
  detalle_pedido_id Int
  tratamiento_id    Int
  precio_usd        Decimal         @db.Decimal(10, 4)
  detalles_pedido   detalles_pedido @relation(fields: [detalle_pedido_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tratamientos      tratamientos    @relation(fields: [tratamiento_id], references: [id], onUpdate: Restrict)

  @@index([detalle_pedido_id], map: "detalle_pedido_id")
  @@index([tratamiento_id], map: "tratamiento_id")
}

model configuracion_sistema {
  id                   Int      @id @default(1)
  dolar_oficial        Decimal  @db.Decimal(10, 2)
  ultima_actualizacion DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// RECLAMOS
// ═══════════════════════════════════════════════════════════

model reclamos {
  id               Int              @id @default(autoincrement())
  usuario_id       Int
  pedido_id        Int
  tipo             reclamos_tipo    @default(OTRO)
  descripcion      String           @db.Text
  estado           reclamos_estado  @default(ABIERTO)
  fecha_creacion   DateTime         @default(now()) @db.DateTime(0)
  fecha_resolucion DateTime?        @db.DateTime(0)
  respuesta_admin  String?          @db.Text
  usuarios         usuarios         @relation(fields: [usuario_id], references: [id], onUpdate: Restrict)
  pedidos          pedidos          @relation(fields: [pedido_id], references: [id], onUpdate: Restrict)

  @@index([usuario_id], map: "idx_reclamos_usuario")
  @@index([pedido_id], map: "idx_reclamos_pedido")
}

enum reclamos_tipo {
  PRODUCTO_DEFECTUOSO
  RECETA_INCORRECTA
  DEMORA_ENVIO
  FACTURACION
  OTRO
}

enum reclamos_estado {
  ABIERTO
  EN_REVISION
  RESUELTO
  CERRADO
}

// ═══════════════════════════════════════════════════════════
// PAGOS PARCIALES
// ═══════════════════════════════════════════════════════════

model pagos {
  id              Int      @id @default(autoincrement())
  pedido_id       Int
  monto_ars       Decimal  @db.Decimal(15, 2)
  metodo_pago     String?  @db.VarChar(50)
  referencia      String?  @db.VarChar(100)
  notas           String?  @db.Text
  fecha_pago      DateTime @default(now()) @db.DateTime(0)
  registrado_por  Int
  pedidos         pedidos  @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  usuarios        usuarios @relation(fields: [registrado_por], references: [id], onUpdate: Restrict)

  @@index([pedido_id], map: "idx_pagos_pedido")
}

// ═══════════════════════════════════════════════════════════

model zonas_envio {
  id              Int      @id @default(autoincrement())
  provincia       String   @db.VarChar(100)
  cp_desde        String   @db.VarChar(10)
  cp_hasta        String   @db.VarChar(10)
  costo_andreani  Decimal  @db.Decimal(15, 2)
  dias_andreani   Int?
  costo_correo    Decimal  @db.Decimal(15, 2)
  dias_correo     Int?
  activo          Boolean  @default(true)
  fecha_creacion  DateTime @default(now()) @db.DateTime(0)

  @@index([cp_desde, cp_hasta], map: "idx_zonas_cp")
}